<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Checked/unchecked arithmetic policy implementations and supporting models for rational arithmetic.</Description>
    <PackageTags>generic-math;implementations;models;rational</PackageTags>
    <Title>Rational arithmetic models</Title>
    <VersionPrefix>0.1.3</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>0.1.3</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <NoWarn Condition="'$(Configuration)' == 'Debug' OR '$(VersionSuffix)' != ''">$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Ratiocinia.Models</RootNamespace>
    <TargetFrameworks>net7.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion Condition="'$(TargetFramework)' == 'net9.0'">13</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
    <PackageReference Include="MathFoundations.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratiocinia.Algorithms.Generic\Ratiocinia.Algorithms.Generic.csproj" />
    <ProjectReference Include="..\Internal\Ratiocinia.Algorithms.Generic.Internal\Ratiocinia.Algorithms.Generic.Internal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Tests.Models, </_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
