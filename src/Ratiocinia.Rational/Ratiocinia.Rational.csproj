<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Generic Rational&lt;T&gt; for any IBinaryInteger&lt;T&gt;, fully integrated with .NET generic math. Arbitrary-precision rational arithmetic via BigIntegerRational.</Description>
    <PackageTags>fraction;generic-math;numeric;rational</PackageTags>
    <Title>Rational&lt;T&gt;</Title>
    <VersionPrefix>0.1.2</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>0.1.2</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <NoWarn Condition="'$(Configuration)' == 'Debug' OR '$(VersionSuffix)' != ''">$(NoWarn);CS1591</NoWarn>
    <TargetFrameworks>net7.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ratiocinia.Algorithms.Specialized\Ratiocinia.Algorithms.Specialized.csproj" />
    <ProjectReference Include="..\Ratiocinia.Models\Ratiocinia.Models.csproj" />
  </ItemGroup>

</Project>
